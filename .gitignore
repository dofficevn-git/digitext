# Generated by Cargo
# will have compiled files and executables
debug
target
# Chỉ bỏ qua thư mục dữ liệu mẫu ở GỐC repo (dữ liệu quét nhạy cảm), KHÔNG bỏ qua mọi
# thư mục/tệp tên "data" ở bất kỳ đâu (vd một module Rust tên data/ sẽ biến mất khỏi git).
/data/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

.rtk
# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Local scratch / draft documents
dirty-docs/

# Claude Code personal per-project overrides (permissions, etc.) — không commit
.claude/settings.local.json

# OCR output = derived sensitive data (never commit)
ocr_output/
*.ocr.json
*.fields.json

# JWT signing key (Ed25519 PEM) — secret, auto-generated per dev run
jwt-ed25519.pem

# ─── Secret & biến môi trường THẬT — KHÔNG BAO GIỜ commit (chỉ commit *.example) ───
# docker-compose + server đọc secret (PG_PASSWORD, MINIO_*, MEILI_KEY, DATABASE_URL…)
# từ .env; Terraform tfvars/state và ansible-vault cũng chứa secret. Chặn tất cả, chừa
# lại đúng các file mẫu *.example đã commit làm template.
.env
.env.*
!.env.example
!.env.*.example
*.tfvars
!*.tfvars.example
*.tfstate
*.tfstate.*
.terraform/
**/vault.yml
**/vault.yaml
**/*.key
!**/*.pub
.secrets/

# Swift build artifacts
.build/
.DS_Store

# Node / JS
node_modules/
dist/

# Tauri generated
desktop/src-tauri/gen/
# NOTE: capabilities/ is SOURCE (defines IPC permissions like updater:default), not
# generated — it must be committed, otherwise CI builds ship with no permissions and
# the updater/scanner IPC is blocked at runtime. Do NOT ignore it.

# Kho dữ liệu e2e tạm (server data_dir khi test)
scratch-data-e2e/

# Triton: artifact model KHÔNG commit — build từ triton/build/ (§P-M1). Chỉ config.pbtxt +
# model.py + logic là source. .gitkeep giữ cấu trúc thư mục version.
triton/models/**/*.plan
triton/models/**/*.onnx
triton/models/**/encoder.onnx
triton/models/**/decoder.onnx
triton/build/onnx/
triton/models/**/PROVENANCE.txt
triton/models/BUILD_PROVENANCE.txt
# Cache bytecode Python của backend
__pycache__/
*.pyc

# OCR preview: DỮ LIỆU QUÉT + OUTPUT đều NHẠY CẢM — KHÔNG commit. (ml/tools/data không khớp
# mục `/data/` neo-gốc ở trên nên phải chặn riêng.)
ml/tools/data/
ml/tools/out/
# ml/data = dữ liệu quét nhạy cảm (không khớp `/data/` neo-gốc) — KHÔNG commit.
ml/data/
# PaddleOCR pretrained tải về để build engine — artifact, KHÔNG commit (dựng lại từ build script).
triton/build/paddle/
# KIE distillation (ml/finetune/kie/data): ảnh trang render từ PDF nhạy cảm + nhãn VLM/gold =
# DỮ LIỆU DẪN XUẤT NHẠY CẢM. Mục `/data/` ở trên neo-gốc nên KHÔNG khớp đường dẫn này ⇒ chặn riêng.
ml/finetune/kie/data/
# Fine-tune SVTR (§P-M5): data synthetic + checkpoint + inference đều là ARTIFACT — KHÔNG commit.
ml/finetune/**/train_data/
ml/finetune/**/output/
ml/finetune/**/inference/
ml/finetune/**/pretrain/
# Golden-set (ảnh + nhãn) = dữ liệu đánh giá — KHÔNG commit (§P-M4 README).
ml/bench/golden-set/img/
ml/bench/golden-set/*.jsonl
ml/bench/golden-set/*.txt
**/.DS_Store

# VietOCR fine-tune artefacts (log huấn luyện + LMDB crop ảnh THẬT) — không commit
ml/finetune/kie/train.log
ml/finetune/kie/valid_data/

# code-review-graph: knowledge graph cục bộ (graph.db + index) — ARTIFACT dựng lại
# được bằng `code-review-graph build`, KHÔNG commit.
.code-review-graph/

# Gói cứu hộ từ server Ubuntu (binary Linux + bảng symbol + dump DB).
# Chứa credential + dữ liệu thật — TUYỆT ĐỐI KHÔNG commit.
digitext-rescue/
digitext-rescue.tar.gz

# Ghi đè compose riêng từng máy (cổng, mount cục bộ) — không commit.
docker-compose.override.yml
