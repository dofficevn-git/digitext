# Cấu hình OTel Collector gateway → SigNoz. Copy sang .env rồi sửa.

# Endpoint OTLP của backend SigNoz mà gateway forward tới (host:port, KHÔNG kèm scheme).
#   Self-host (Foundry) cùng node : host.docker.internal:4317
#   Self-host node khác           : <signoz-host>:4317
#   SigNoz Cloud                  : ingest.<region>.signoz.cloud:443
SIGNOZ_OTLP_ENDPOINT=host.docker.internal:4317

# TLS tới backend SigNoz. Self-host LAN plaintext → true. SigNoz Cloud → false.
SIGNOZ_OTLP_INSECURE=true

# Khoá ingest của SigNoz Cloud. Self-host để RỖNG.
SIGNOZ_INGESTION_KEY=

# Target DCGM exporter (metric GPU) — khớp infra/observability/prometheus/prometheus.yml.
DCGM_TARGET=gpu-ocr-01:9400
