# Đường vào API DigiText trên OCR PC — Caddy + Let's Encrypt (TLS-ALPN-01 qua cổng 443), cổng 443 trực tiếp (30/10, sửa 2/11/2026).
#
# Anh Hiếu chốt: đi THẲNG qua cổng mở trên router, KHÔNG dùng Cloudflare tunnel nữa (tunnel giới hạn 100 s / 100 MB
# mỗi yêu cầu, thêm một tầng có thể rớt). Một tên duy nhất `api.digitext.vn` (đã đóng cứng trong updater của mọi bản
# desktop đã cài) → bản ghi A ở DNS của iNET (nameserver iNET, KHÔNG Cloudflare — anh chốt lại 2/11/2026) trỏ IP tĩnh
# 113.190.254.219; router NAT 443 → 192.168.100.10:443.
#
# Cài: caddy.exe chuẩn (không cần module dns) đặt C:\DigiText-Caddy\caddy.exe; không có bí mật nào trên máy chủ.
#   caddy.exe validate --config D:\DigiText\infra\caddy\Caddyfile
#   sc.exe create DigiText-Caddy binPath= "C:\DigiText-Caddy\caddy.exe run --config D:\DigiText\infra\caddy\Caddyfile" start= auto
# Firewall: mở 443 TCP inbound từ mọi nơi; 8080 chỉ loopback (API bind 127.0.0.1). Không cần 80 (TLS-ALPN-01, không redirect).
# API: DIGITEXT_BEHIND_PROXY=true để audit_log ghi IP máy trạm từ X-Forwarded-For.

{
	# Thư mục chứng chỉ/trạng thái — tách khỏi hồ sơ người dùng để service SYSTEM đọc được.
	storage file_system {
		root C:\DigiText-Caddy\data
	}
	# Không mở 80 → tắt redirect HTTP→HTTPS tự động.
	auto_https disable_redirects
	log {
		output file C:\DigiText-Caddy\caddy.log {
			roll_size 50MiB
			roll_keep 5
		}
		level INFO
	}
}

api.digitext.vn {
	# 2/11/2026: DNS quản lý thẳng ở iNET (anh chốt, KHÔNG Cloudflare) → chứng chỉ xin bằng TLS-ALPN-01 qua chính cổng 443
	# đã NAT; không cần token, không cần cổng 80 (80 đang là IIS). Điều kiện: bản ghi A api.digitext.vn → 113.190.254.219
	# đã có hiệu lực TRƯỚC khi Caddy chạy; gia hạn tự động cũng qua 443.
	tls {
		issuer acme {
			disable_http_challenge
		}
	}

	encode zstd gzip

	# Không còn giới hạn kiểu tunnel: tải lên 2 GB, chờ API tới 15 phút (đóng gói, tải PDF ký lớn).
	request_body {
		max_size 2GB
	}

	reverse_proxy 127.0.0.1:8080 {
		transport http {
			dial_timeout 10s
			response_header_timeout 15m
			read_timeout 15m
			write_timeout 15m
		}
		# X-Forwarded-For / X-Forwarded-Proto / X-Forwarded-Host được Caddy đặt sẵn.
		flush_interval -1
	}

	log {
		output file C:\DigiText-Caddy\access.log {
			roll_size 100MiB
			roll_keep 10
		}
	}
}

# Trang web digitext.vn / www: trước đi tunnel Cloudflare `ocr-pc` → IIS cổng 80 trên chính OCR PC (2/11/2026).
# Bỏ tunnel: A @/www → 113.190.254.219; HTTP 80 vẫn do IIS trả thẳng (NAT 80 sẵn), HTTPS 443 Caddy nhận rồi chuyển vào IIS.
digitext.vn, www.digitext.vn {
	tls {
		issuer acme {
			disable_http_challenge
		}
	}
	reverse_proxy 127.0.0.1:80 {
		header_up Host digitext.vn
	}
}
