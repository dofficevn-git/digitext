# ══════════════════════════════════════════════════════════════════════════
#  ocr.env.example → /etc/digitext/ocr.env  (EnvironmentFile của digitext@ocr)
#  Cấu hình worker OCR (crates/digitext-ocr, §G/§P). Quyền 0640 root:digitext.
#  scripts/setup-ai-node.sh copy file này nếu /etc/digitext/ocr.env chưa có.
#  Mọi khoá + kiểm hợp lệ: xem crates/digitext-ocr/src/config.rs (fail-fast §P1).
# ══════════════════════════════════════════════════════════════════════════

# ── BẮT BUỘC ──────────────────────────────────────────────────────────────
# DB ở SERVER KHÁC — đổi host/user/pass/port cho đúng. Chỉ postgres://|postgresql://
DIGITEXT_DATABASE_URL=postgres://digitext:CHANGE_ME@DB_HOST:5432/digitext

# Triton chạy CÙNG node (compose bind loopback). gRPC = 8001, HTTP health = 8000.
DIGITEXT_TRITON_ENDPOINT=http://127.0.0.1:8001
DIGITEXT_TRITON_HTTP_ENDPOINT=http://127.0.0.1:8000

# ── Vòng lặp worker ───────────────────────────────────────────────────────
# GIỮ false tới khi Triton READY (có engine) + DB tới được. false = chỉ phục vụ
# /healthz /readyz, KHÔNG claim job, KHÔNG kết nối DB (an toàn khởi động sớm).
DIGITEXT_WORKER_ENABLED=false
DIGITEXT_WORKER_ID=ocr-node-1
# Số LÀN job chạy song song trong worker (Worker::run_loop). Xử lý một job phần lớn là CHỜ mạng
# (MinIO fetch + vLLM decode ~3,5 s ở tuyến v2), không phải CPU — 1 làn ghim vLLM ở đúng 1 chuỗi
# và bỏ phí GPU. Nâng thì phải nâng --max-num-seqs của vLLM tương ứng
# (infra/compose/vllm/docker-compose.yml), nếu không chỉ dời chỗ xếp hàng.
DIGITEXT_WORKER_CONCURRENCY=4
DIGITEXT_INFER_BATCH_SIZE=8

# ── Nguồn ảnh trang + kho PDF (dưới /var/lib/digitext, ReadWritePaths của unit) ──
DIGITEXT_PAGE_SOURCE_DIR=/var/lib/digitext/pages
DIGITEXT_PDF_STORE_DIR=/var/lib/digitext/pdf
DIGITEXT_PDF_DPI=300
# Trang PDF KHÔNG có ảnh JPEG nhúng (CCITTFaxDecode G4 của máy quét đen trắng như Fujitsu
# PaperStream, JBIG2, trang vector) được RASTER HOÁ bằng `pdftoppm` thay vì bỏ trang.
# ⇒ node PHẢI cài poppler-utils (`apt install poppler-utils`).
# DIGITEXT_PDF_RASTER_DPI=200
# systemd có PATH tối giản — đặt đường dẫn tuyệt đối nếu worker báo không chạy được pdftoppm.
# DIGITEXT_PDFTOPPM_BIN=/usr/bin/pdftoppm

# ── Nguồn ảnh trang qua MinIO (server khác) — BẬT khi khai ĐỦ 4 khoá dưới ──
# Worker fetch ảnh theo key `{document_id}/{page_no}.jpg` trong bucket (khớp cách server ingest
# PUT ảnh). Khai đủ 4 khoá → dùng MinIO thay DIGITEXT_PAGE_SOURCE_DIR; bỏ hết → dùng thư mục cục bộ.
# DIGITEXT_MINIO_ENDPOINT=http://192.168.100.13:9000
# DIGITEXT_MINIO_BUCKET=pages
# DIGITEXT_MINIO_ACCESS_KEY=digitext
# DIGITEXT_MINIO_SECRET_KEY=changeme123
# DIGITEXT_MINIO_REGION=us-east-1

# ── Tiling / fallback / retry (mặc định hợp lý; đổi khi tinh chỉnh) ──────────
DIGITEXT_TILE_SIZE=1024
DIGITEXT_TILE_OVERLAP=64
DIGITEXT_CONF_FALLBACK=0.80
DIGITEXT_MAX_RETRIES=5
DIGITEXT_RETRY_BASE_DELAY_MS=200
DIGITEXT_RETRY_MAX_DELAY_MS=30000
DIGITEXT_LEASE_SECONDS=120

# HTTP health bind. Giữ loopback (§P8); metric đẩy OTLP, không có /metrics.
DIGITEXT_METRICS_ADDR=127.0.0.1:9090

# ── LLM corrector (§G6/§G7) — MẶC ĐỊNH TẮT (trung thực trước). Bật sau §P-M4 gate. ──
DIGITEXT_LLM_CORRECTOR_ENABLED=false
DIGITEXT_LLM_CORRECTOR_TAU=0.75
DIGITEXT_LLM_CORRECTOR_MAX_EDIT=2

# ── VLM Mode 2 (§G6) — bóc TRƯỜNG từ ẢNH cho ca khó (Qwen2.5-VL-7B qua vLLM). MẶC ĐỊNH TẮT:
# luôn vào review, không auto-commit. Bật cần: (1) serve Qwen2.5-VL qua vLLM, (2) cờ dưới = true +
# khai ENDPOINT/MODEL (main tự dựng extractor + with_vlm), (3) engines OCR (Triton) đã lên. Thiếu
# ENDPOINT/MODEL khi bật ⇒ worker cảnh báo + chạy KHÔNG có VLM (an toàn). ──
DIGITEXT_VLM_FALLBACK_ENABLED=false
# vLLM phục vụ Qwen2.5-VL (OpenAI-compatible). Chỉ cần khi ENABLED=true.
DIGITEXT_VLM_ENDPOINT=http://127.0.0.1:8003/v1/chat/completions
DIGITEXT_VLM_MODEL=Qwen2.5-VL-7B-Instruct-AWQ
DIGITEXT_VLM_TIMEOUT_MS=60000

# ── Bóc tách 16 trường v2 — VLM-primary (§G6bis, docs/plan-boc-tach-16-truong-v2.md). Mặc định
# `v1` (heuristic + Mode 2 gate như cũ). Đặt `v2` ⇒ job `extract_fields` (nút ③ màn "Máy chủ")
# do VLM đọc thẳng ảnh trang bóc đủ 16 trường; nhánh ocr KHÔNG chạy heuristic/Mode 2 nữa; đòi
# DIGITEXT_VLM_ENDPOINT/MODEL ở trên (thiếu ⇒ worker FAIL-FAST, không no-op âm thầm). Kết quả
# luôn là lớp gợi ý verified=false + review_queue — §G7 giữ nguyên. ──
DIGITEXT_FIELDS_ENGINE=v1
# Số trang ĐẦU mỗi tài liệu gửi VLM (1..10; 5 trường header chỉ có ở trang đầu văn bản).
DIGITEXT_FIELDS_V2_MAX_PAGES=1

# ── Đóng gói SIP/AIP/DIP (TT 05/2025, worker chạy trong digitext@ocr) ─────────
# Quét virus gói tin khi nạp (WF-4, Điều 22.2.d) — clamd INSTREAM. Node GPU chạy
# clamav qua compose (infra/compose/triton, bind loopback 3310). KHÔNG đặt ⇒
# packages.virus_scan ghi 'not_configured' (minh bạch, không chặn build).
DIGITEXT_CLAMD_ADDR=127.0.0.1:3310

# Font TTF cho tệp văn bản xác thực DIP (Điều 42.2 — cần đủ dấu tiếng Việt,
# khuyến nghị Times New Roman). Thiếu ⇒ gói DIP fail với lỗi rõ ràng.
# Cài: đặt times.ttf vào /etc/digitext/fonts/ (hoặc font hệ thống có sẵn).
DIGITEXT_CERT_FONT=/etc/digitext/fonts/times.ttf

# Ngày nghỉ lễ NGOÀI lễ dương lịch cố định (Tết âm, Giỗ Tổ, nghỉ bù) — cho SLA
# 07 ngày LÀM VIỆC (WF-3, Điều 21.4). Khai MỖI NĂM khi có lịch nghỉ chính thức;
# đọc lại mỗi chu kỳ quét nên đổi giá trị không cần restart. Dạng YYYY-MM-DD,…
# Ví dụ 2026: DIGITEXT_HOLIDAYS=2026-02-16,2026-02-17,2026-02-18,2026-02-19,2026-02-20,2026-04-26
DIGITEXT_HOLIDAYS=

# ── Observability (tuỳ chọn) — trỏ OTLP về SigNoz nếu có. Bỏ trống = chỉ log console. ──
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317
# OTEL_SERVICE_NAME=digitext-ocr
# DIGITEXT_OTEL_ENABLED=true
RUST_LOG=info
