{{- with secret "database/creds/digitext-api" -}}
DATABASE_URL=postgres://{{ .Data.username }}:{{ .Data.password }}@{{ env "POSTGRES_HOST" }}:{{ env "POSTGRES_PORT" }}/{{ env "POSTGRES_DB" }}?sslmode=require
{{- end }}
DIGITEXT_BIND={{ env "DIGITEXT_BIND" }}
DIGITEXT_JWT_KEY_PATH={{ env "DIGITEXT_JWT_KEY_PATH" }}
DIGITEXT_DATA_DIR={{ env "DIGITEXT_DATA_DIR" }}
DIGITEXT_BEHIND_PROXY={{ env "DIGITEXT_BEHIND_PROXY" }}
DIGITEXT_SIGN_TRUST_ROOTS={{ env "DIGITEXT_SIGN_TRUST_ROOTS" }}
RUST_LOG={{ env "DIGITEXT_LOG" }}
