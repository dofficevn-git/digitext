# {{ ansible_managed }}
# /etc/digitext/api.env — EnvironmentFile cho digitext@api (systemd).
# Render bởi Ansible role `api`; secret từ ansible-vault. mode 0640 root:{{ deploy_user }}.
# ĐỪNG sửa tay trên host — sẽ bị ghi đè ở lần chạy playbook sau.
DATABASE_URL=postgres://{{ vault_pg_user }}:{{ vault_pg_password }}@{{ postgres_host }}:{{ postgres_port }}/{{ postgres_db }}
DIGITEXT_BIND={{ digitext_api_bind }}
DIGITEXT_JWT_KEY_PATH={{ digitext_api_jwt_key_path }}
DIGITEXT_DATA_DIR={{ digitext_api_data_dir }}
DIGITEXT_BEHIND_PROXY={{ digitext_api_behind_proxy | lower }}
DIGITEXT_SIGN_TRUST_ROOTS={{ digitext_api_sign_trust_roots }}
{% if digitext_cert_font is defined %}
# Font TTF đủ dấu tiếng Việt — biên bản Phụ lục VII + văn bản xác thực (TT 05/2025).
DIGITEXT_CERT_FONT={{ digitext_cert_font }}
{% endif %}
{% if digitext_holidays is defined %}
# Ngày nghỉ lễ (Tết âm, Giỗ Tổ, nghỉ bù) cho SLA ngày làm việc — khai mỗi năm.
DIGITEXT_HOLIDAYS={{ digitext_holidays }}
{% endif %}
RUST_LOG={{ digitext_api_log }}
