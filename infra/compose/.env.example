# ══════════════════════════════════════════════════════════════════════════
#  infra/compose/.env.example — HỢP ĐỒNG secret cho HẠ TẦNG DEV (docker-compose).
#  Copy → .env rồi đổi giá trị. docker-compose TỰ nạp file .env cùng thư mục.
#  CHỈ dùng cho dev một-node; staging/production dùng ansible-vault (xem docs/env.md).
#
#  compose dùng `${VAR:?...}` nên THIẾU biến là dừng ngay — không còn im lặng chạy bằng
#  mật khẩu mặc định. Sinh giá trị thật, ĐỪNG copy nguyên placeholder dưới đây:
#      PG_PASSWORD=$(openssl rand -base64 24)
#      MINIO_PASSWORD=$(openssl rand -base64 24)
#      MEILI_KEY=$(openssl rand -base64 24)
# ══════════════════════════════════════════════════════════════════════════

# Postgres
PG_USER=digitext
PG_PASSWORD=THAY_BANG_GIA_TRI_NGAU_NHIEN
PG_DB=digitext

# MinIO (object store S3)
MINIO_USER=digitext
MINIO_PASSWORD=THAY_BANG_GIA_TRI_NGAU_NHIEN

# Meilisearch master key (>= 16 bytes)
MEILI_KEY=THAY_BANG_GIA_TRI_NGAU_NHIEN_>=16_BYTE
