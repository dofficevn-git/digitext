# infra/compose/ocr/.env.example — copy → .env (docker compose tự nạp).
# Cấu hình dịch vụ OCR toàn văn. Không liên quan CSDL, MinIO hay Meilisearch.

# BẮT BUỘC. Phải khớp DIGITEXT_OCR_HTTP_API_KEY bên DigiText.
#   sinh khoá:  openssl rand -hex 32
OCR_API_KEY=THAY_BANG_GIA_TRI_NGAU_NHIEN

# Cổng trên máy chủ. Tránh đụng: digitext-api 8080, Triton 8000/8001, vLLM 8003.
# Dia chi buoc cong. 127.0.0.1 = chi may nay goi duoc.
# Dat 0.0.0.0 neu may KHAC (vd DigiText o may dev) can goi sang qua LAN.
# Mo ra LAN thi OCR_API_KEY la thu DUY NHAT chan nguoi khac dung.
OCR_BIND=127.0.0.1



# Nên ≥ DIGITEXT_WORKER_CONCURRENCY của DigiText (mặc định 4).
OCR_THREADS=4

# Ngôn ngữ model PHÁT HIỆN (DBNet) của PaddleOCR. 'en' tách dòng tốt cho tiếng
# Việt; phần đọc chữ luôn là VietOCR nên không cần 'vi' ở đây.
OCR_DET_LANG=en

# GPU: chỉ có tác dụng khi up với docker-compose.gpu.yml (image CUDA). Với file
# CPU thì để false — bật true trên image CPU sẽ dừng ngay lúc nạp VietOCR (cố ý,
# để không rơi về CPU âm thầm).
OCR_USE_GPU=false
# Số suy luận chạy đồng thời trên GPU (trần VRAM = số này × OCR_REC_BATCH).
OCR_GPU_CONCURRENCY=2
# VRAM (MB) paddle được giữ cho DBNet.
OCR_DET_GPU_MEM_MB=1024
# Số dòng mỗi mẻ VietOCR. CPU: 8. GPU: 32.
OCR_REC_BATCH=8

# Trọng số VietOCR đang phục vụ (đường dẫn TRONG container; thư mục
# ocr/models/vietocr được mount vào /models/vietocr). Đổi sang bản fine-tune:
#   OCR_REC_WEIGHTS=/models/vietocr/vgg_transformer_ft_v1.pth
OCR_REC_WEIGHTS=/models/vietocr/vgg_transformer.pth

# In một dòng thời gian (det/tổng/chờ) cho mỗi request.
OCR_LOG_TIMING=true

# Tran tai nguyen cua container. Tren may khong co swap, container an het RAM
# se khien OOM killer keo sap ca phien do hoa — dat tran de thiet hai gioi han
# trong container. Overlay GPU mặc định 8g / 6 CPU.
OCR_MEM_LIMIT=6g
OCR_CPUS=4
