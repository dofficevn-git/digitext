# OCR trên card Blackwell (RTX 5070 Ti 16 GB, sm_120) — OCR PC, 30/10/2026.
# Chép các dòng này vào infra/compose/ocr/.env (giữ OCR_API_KEY và phần còn lại như .env trên Alienware), rồi:
#   docker compose -f infra/compose/ocr/docker-compose.yml -f infra/compose/ocr/docker-compose.gpu.yml \
#     --env-file infra/compose/ocr/.env up -d --build
#
# Trình tự kiểm (dừng ở bước đầu lỗi):
#   nvidia-smi                                           → CUDA ≥ 12.9, driver ≥ 576
#   nvidia-smi -L                                         → UUID card rời cho GPU_DEVICE_ID (máy có iGPU)
#   docker compose ... run --rm ocr python -c "import torch;print(torch.__version__, torch.cuda.get_arch_list())"
#                                                         → 2.7.1+cu128, có 'sm_120'
#   docker compose ... run --rm ocr python -c "import paddle;paddle.utils.run_check()"
#   health: curl 127.0.0.1:5012/api/ocr/health            → gpu:true, gpu_name chứa "5070", warmup:"ok"

# --- Image: base CUDA 12.9 + cuDNN 9 (Blackwell cần cuDNN 9) ---
OCR_CUDA_IMAGE=nvidia/cuda:12.9.1-cudnn-runtime-ubuntu22.04
# torch PHẢI có hậu tố +cu128: `torch==2.7.1` trơn trên PyPI là bản cu126, KHÔNG có sm_120.
OCR_TORCH_INDEX=https://download.pytorch.org/whl/cu128
OCR_TORCH_VERSION=2.7.1+cu128
OCR_TORCHVISION_VERSION=0.22.1+cu128
OCR_REQS=requirements-ocr-gpu-cu128.txt

# --- Card: chọn đúng GPU rời (nvidia-smi -L → GPU-xxxxxxxx-...) ---
# GPU_DEVICE_ID=GPU-00000000-0000-0000-0000-000000000000

# --- Cổng trên OCR PC: 5002 đã bị web KIE cũ chiếm, 5001 là n8n → 5012. Worker: DIGITEXT_OCR_HTTP_ENDPOINT=http://127.0.0.1:5012
OCR_PORT=5012
OCR_BIND=127.0.0.1

# --- Ngân sách VRAM 16 GB chạy chung vLLM (VLLM_GPU_FRACTION=0.70 ≈ 11,4 GB — 0.55 không đủ trên 5070 Ti, engine sập 2/11): đo 30 phút rồi nới ---
OCR_GPU_CONCURRENCY=2
OCR_REC_BATCH=64
OCR_DET_GPU_MEM_MB=512
OCR_HW_WORKERS=16
# GPU-PV của WSL2 chậm hơn bare-metal 1,3–2× mỗi lần gọi nhỏ: bù bằng batch lớn (64→96 nếu VRAM còn).

# --- Máy 64 GB RAM, 16 nhân: nới trần container ---
OCR_MEM_LIMIT=12g
OCR_CPUS=10
OCR_THREADS=16
