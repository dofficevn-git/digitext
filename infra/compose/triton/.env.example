# infra/compose/triton/.env.example — copy → .env (docker compose tự nạp).
# Chỉ cấu hình Triton của NODE GPU. DB/MinIO/Meili ở server khác — không khai ở đây.

# Image Triton. Đổi tag theo bản driver đã cài (bản mới cần driver mới hơn).
#   24.08-py3 ≈ CUDA 12.6, cần driver ≥ 545. Xem: https://docs.nvidia.com/deeplearning/frameworks/support-matrix
TRITON_IMAGE=nvcr.io/nvidia/tritonserver:24.08-py3
