# ══════════════════════════════════════════════════════════════════════════
#  .env.example → .env  cho giao diện web + KIE (docker-compose.yml cạnh đây)
#
#  KHÔNG PHẢI cấu hình của dịch vụ OCR toàn văn — cái đó ở ocr/.env.ocr.example
#  và chạy hoàn toàn tách biệt trên cổng 5002.
#
#      cp .env.example .env && $EDITOR .env
#      docker compose --env-file .env up -d --build
# ══════════════════════════════════════════════════════════════════════════

# ── SQL Server ────────────────────────────────────────────────────────────
# Mật khẩu sa. PHẢI đặt trước lần chạy đầu: SQL Server chốt nó vào volume
# sqlserver-data lúc khởi tạo, đổi trong file này về sau KHÔNG có tác dụng.
# Đổi thật thì phải ALTER LOGIN trong CSDL, hoặc xoá volume và mất dữ liệu.
# Yêu cầu: ≥8 ký tự, đủ hoa/thường/số/ký tự đặc biệt, nếu không container
# lăn ra chết lúc khởi tạo mà log chỉ nói mơ hồ.
DB_PASSWORD=

DB_DATABASE=kie_pla
MSSQL_PID=Developer
MSSQL_VERSION=2022-latest

# Cổng SQL Server nhìn từ ngoài. Giữ loopback — không có lý do gì mở CSDL
# ra LAN khi web đã nói chuyện với nó qua mạng nội bộ của compose.
DB_BIND=127.0.0.1
DB_PORT=1433

# ── vLLM (Vintern-1B fine-tune, phục vụ bóc 8 trường) ─────────────────────
# Ảnh vLLM. Xem ocr/.env.vllm.rtx5070.example nếu card là Blackwell (50xx) —
# bản 0.8.5 không chạy được trên kiến trúc đó.
VLLM_IMAGE=vllm/vllm-openai:v0.8.5
VLLM_MODEL=vnkie
VLLM_TIMEOUT=300
VLLM_BIND=127.0.0.1
VLLM_PORT=3000

# PHẦN VRAM XIN CẤP — đọc kỹ trước khi đổi.
# Đây là tỉ lệ trên TOÀN BỘ card, không phải trên phần còn trống. Máy này đã
# có một vLLM khác giữ ~9,3/16GB cho Qwen2.5-VL (cổng 8003) mà DigiText dùng
# để bóc 16 trường. 0.20 ≈ 3,2GB, đủ cho Vintern-1B và vẫn còn biên an toàn.
# Bản gốc để 0.90; giữ nguyên con số đó ở đây là chắc chắn hết VRAM.
VLLM_GPU_FRACTION=0.20

# ── Giao diện web ─────────────────────────────────────────────────────────
# Khoá ký session của Flask. BẮT BUỘC đổi — giá trị mặc định trong app.py là
# một chuỗi công khai, ai biết nó thì giả được phiên đăng nhập bất kỳ.
#   sinh khoá:  openssl rand -hex 32
SECRET_KEY=

# 0.0.0.0 vì đây là giao diện cho người dùng mở từ máy khác trong mạng.
# Nó CHỈ được che bởi màn đăng nhập của app — đừng đưa ra Internet.
WEB_BIND=0.0.0.0
WEB_PORT=5001

# Bản gốc chạy MAX_WORKERS=1 và chưa từng chạy đồng thời. Nâng lên là vùng
# chưa ai thử.
MAX_WORKERS=1
WAITRESS_THREADS=8

# Trần RAM. Không có nó thì một tài liệu bất thường có thể kéo sập cả máy —
# đã xảy ra trên chính node GPU này.
WEB_MEM_LIMIT=6g
