# ══════════════════════════════════════════════════════════════════════════
#  crates/digitext-api/.env.example — HỢP ĐỒNG biến môi trường của binary
#  digitext-api (khớp crates/digitext-api/src/config.rs).
#  Copy → .env cho dev; dev/run-api.sh sẽ nạp. KHÔNG commit .env (đã .gitignore).
#  Production KHÔNG dùng file này: systemd tiêm EnvironmentFile do Ansible render
#  từ ansible-vault. Xem docs/env.md.
# ══════════════════════════════════════════════════════════════════════════

# BẮT BUỘC — chuỗi kết nối Postgres. Thiếu → app dừng ("thiếu biến DATABASE_URL").
# Password phải khớp PG_PASSWORD trong infra/compose/.env.
DATABASE_URL=postgres://digitext:changeme@127.0.0.1:5432/digitext

# Địa chỉ bind. Mặc định 127.0.0.1:8080 (prod đứng sau nginx TLS, §11).
DIGITEXT_BIND=127.0.0.1:8080

# PEM khoá ký Ed25519 (PKCS#8). Thiếu file → tự sinh (CHỈ dev).
# Prod: khoá được cấp sẵn qua Ansible, KHÔNG để app tự sinh.
DIGITEXT_JWT_KEY_PATH=jwt-ed25519.pem

# Thư mục lưu PDF user upload trên đĩa API (luôn ghi; dùng cho download + fallback).
DIGITEXT_DATA_DIR=data

# ── MinIO cho PDF NGUỒN (bucket `pages`) — CÙNG kho worker OCR đọc ─────────────────────────
# BẮT BUỘC ở deployment có node OCR: `POST /documents` PUT PDF vào đây (key = storage_path
# `{project}/{doc}.pdf`) để worker fetch OCR được. Thiếu → tài liệu chỉ nằm trên đĩa API, mọi
# trang OCR sẽ fail "thiếu PDF trong kho". Khoá trùng tên với worker (crates/digitext-ocr) — cùng
# endpoint/bucket/credential. Khai ĐỦ 4 khoá dưới để bật (region mặc định us-east-1).
# DIGITEXT_MINIO_ENDPOINT=http://192.168.100.13:9000
# DIGITEXT_MINIO_BUCKET=pages
# DIGITEXT_MINIO_ACCESS_KEY=digitext
# DIGITEXT_MINIO_SECRET_KEY=changeme123
# DIGITEXT_MINIO_REGION=us-east-1

# ── TT 05/2025 — biểu mẫu/biên bản PDF + SLA ngày làm việc ─────────────────────────────────
# Font TTF đủ dấu tiếng Việt cho biên bản Phụ lục VII + văn bản pháp lý PDF (khuyến nghị
# Times New Roman). Thiếu ⇒ endpoint sinh biểu mẫu trả lỗi rõ ràng.
# DIGITEXT_CERT_FONT=/etc/digitext/fonts/times.ttf

# Ngày nghỉ lễ ngoài lễ dương lịch cố định (Tết âm, Giỗ Tổ, nghỉ bù) cho SLA ngày LÀM VIỆC
# (Điều 21.4, Điều 46.5). Khai mỗi năm, dạng YYYY-MM-DD phân cách dấu phẩy.
# DIGITEXT_HOLIDAYS=2026-02-16,2026-02-17,2026-02-18,2026-02-19,2026-02-20,2026-04-26

# Mức log tracing (tuỳ chọn).
RUST_LOG=info

# Kho object cho PDF 2 lớp — PHẢI trùng bucket của worker (DIGITEXT_PDF_STORE_BUCKET bên digitext-ocr).
# Thiếu dòng này: tải bản PDF/A, "Kiểm tra PDF A", ký số đều trả 503 "kho lưu trữ chưa cấu hình".
DIGITEXT_PDF_STORE_BUCKET=pages

# Thư mục phát bộ cài tự cập nhật app desktop (route /updates, xem develease-desktop.ps1)
DIGITEXT_UPDATES_DIR=updates
