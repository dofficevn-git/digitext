{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DigiText",
  "version": "0.18.15",
  "identifier": "vn.digitext.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DigiText",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "resources": {
      "resources/pdfium/pdfium.dll": "pdfium.dll",
      "resources/pdfium/LICENSE-pdfium.txt": "LICENSE-pdfium.txt"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNEQTVFNEQ4MDg1QjFCODEKUldTQkcxc0kyT1NsUFpCeUdqUWN2QVUzZnRFQnN0MEZoWFFrVzRjU2VyeUk3S2w5bEZ5Y0I1MisK",
      "endpoints": [
        "https://api.digitext.vn/updates/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
