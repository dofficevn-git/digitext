# ══════════════════════════════════════════════════════════════════════════
#  .env.ocr.example → .env  cho dịch vụ OCR toàn văn (serve_ocr.py)
#  Đây là dịch vụ MÁY GỌI MÁY mà DigiText gọi vào. Không liên quan CSDL.
# ══════════════════════════════════════════════════════════════════════════

# Địa chỉ nghe. Giữ loopback nếu DigiText chạy cùng máy; đổi 0.0.0.0 nếu khác máy.
OCR_HOST=127.0.0.1
OCR_PORT=5002

# Số luồng phục vụ. Nên ≥ DIGITEXT_WORKER_CONCURRENCY của DigiText (mặc định 4),
# nếu không worker sẽ xếp hàng chờ nhau.
OCR_THREADS=4

# BẮT BUỘC ở môi trường thật. Bỏ trống = endpoint MỞ, chỉ chấp nhận khi dev.
# Phải khớp DIGITEXT_OCR_HTTP_API_KEY bên DigiText.
#   sinh khoá:  openssl rand -hex 32
OCR_API_KEY=

# Ngôn ngữ PaddleOCR. 'vi' = tiếng Việt.
OCR_LANG=vi

# Dùng GPU cho PaddleOCR. false = CPU (chạy được, chậm hơn).
OCR_USE_GPU=false
