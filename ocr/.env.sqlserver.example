# Copy file này thành .env.sqlserver:
#   copy .env.sqlserver.example .env.sqlserver
#
# QUAN TRONG: DB_PASSWORD phai khop .env app VA password luc tao volume Docker lan dau
# Vi du may khach dang dung: Admin@123456

DB_PORT=1433
DB_DATABASE=kie_pla
DB_USERNAME=sa
DB_PASSWORD=Admin@123456

# Developer = miễn phí dev/test | Express = miễn phí giới hạn
MSSQL_PID=Developer
MSSQL_VERSION=2022-latest
