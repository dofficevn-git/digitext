name: "rec_vietocr"
backend: "python"
max_batch_size: 0
version_policy: { specific: { versions: [4] } }
input [
  { name: "image", data_type: TYPE_FP32, dims: [-1, -1, 3] }
]
output [
  { name: "text", data_type: TYPE_STRING, dims: [-1] },
  { name: "score", data_type: TYPE_FP32, dims: [-1] }
]
instance_group [
  { count: 2, kind: KIND_GPU }
]
parameters {
  key: "intra_op_threads"
  value: { string_value: "2" }
}
