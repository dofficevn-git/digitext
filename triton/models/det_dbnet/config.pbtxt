name: "det_dbnet"
platform: "tensorrt_plan"
max_batch_size: 16
input [
  { name: "x", data_type: TYPE_FP32, dims: [3, 1024, 1024] }
]
output [
  { name: "sigmoid_0.tmp_0", data_type: TYPE_FP32, dims: [1, 1024, 1024] }
]
dynamic_batching {
  preferred_batch_size: [ 4, 8, 16 ]
  max_queue_delay_microseconds: 5000
}
instance_group [
  { count: 1, kind: KIND_GPU }
]
model_warmup [
  {
    name: "warmup_zero"
    batch_size: 1
    inputs {
      key: "x"
      value: { data_type: TYPE_FP32, dims: [3, 1024, 1024], zero_data: true }
    }
  }
]
