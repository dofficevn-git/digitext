name: "rec_svtr_vi"
platform: "tensorrt_plan"
max_batch_size: 0
input [
  { name: "x", data_type: TYPE_FP32, dims: [1, 3, 48, -1] }
]
output [
  { name: "ctc_probs", data_type: TYPE_FP32, dims: [1, -1, 219] }
]
instance_group [
  { count: 2, kind: KIND_GPU }
]
version_policy: { latest: { num_versions: 1 } }
model_warmup [
  {
    name: "warmup_zero"
    batch_size: 1
    inputs {
      key: "x"
      value: { data_type: TYPE_FP32, dims: [1, 3, 48, 320], zero_data: true }
    }
  }
]
